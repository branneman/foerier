{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,

    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    // Node 24 runs TypeScript directly by stripping types, which only works
    // for syntax that erases to whitespace — no enums, no parameter
    // properties, no namespaces. `api` relies on that for `npm run dev:api`,
    // so the constraint is enforced repo-wide rather than discovered at
    // runtime in one package.
    "erasableSyntaxOnly": true,

    // Relative imports in `api` and `shared` carry an explicit `.ts`
    // extension. Node's ESM resolver does not guess extensions, so
    // `node src/index.ts` — which runs the dev server, the migration CLI, and
    // the Maintainer bootstrap script — cannot resolve an extensionless
    // specifier no matter what the type checker thinks. Vite and esbuild
    // handle `.ts` specifiers fine, so this costs nothing on the bundled side.
    "allowImportingTsExtensions": true
  }
}
